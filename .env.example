# Application Info
VITE_APP_NAME="MUN COMPUTER"
VITE_APP_VERSION="1.0.0"
VITE_APP_ENV="development"

# Frontend -> Backend API Configuration (Optional Express Server)
VITE_API_BASE_URL="/api"
VITE_API_TIMEOUT_MS=15000

# Firebase / Cloud Firestore Configuration (Set in Vercel for production project mun-computer-b55be)
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN="mun-computer-b55be.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="mun-computer-b55be"
VITE_FIREBASE_STORAGE_BUCKET="mun-computer-b55be.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="876598783228"
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_MEASUREMENT_ID="G-W44FNRTPR4"
VITE_FIREBASE_DATABASE_ID=""

# Express / PHP Application Settings
APP_NAME="MUN COMPUTER"
APP_ENV="local"
APP_DEBUG=true
PORT=3000
APP_URL="http://localhost:3000"
FRONTEND_URL="http://localhost:3000"

# MySQL Database Configuration (Configure for persistent MySQL deployment)
DB_CONNECTION="mysql"
DB_HOST="127.0.0.1"
DB_PORT="3306"
DB_DATABASE="mun_computer_db"
DB_USERNAME="root"
DB_PASSWORD=""
DB_CHARSET="utf8mb4"
DB_COLLATION="utf8mb4_unicode_ci"

# Authentication, Cookie & Encryption Secrets
JWT_SECRET="replace_with_64_char_random_hex_secret"
JWT_TTL_MINUTES=120
SESSION_LIFETIME_MINUTES=120

# SMS & Email OTP Gateway (Required for live production OTP delivery)
# When unset in local/dev mode, API indicates providerConfigured=false
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
FAST2SMS_API_KEY=""
FAST2SMS_ROUTE="dlt"
FAST2SMS_SENDER_ID="MUNCMP"
FAST2SMS_TEMPLATE_ID=""
SMS_API_KEY=""
SMS_SENDER_ID="MUNCMP"
WHATSAPP_API_KEY=""

# Phase 08 Backup Encryption & Cloud Offsite Storage
BACKUP_MASTER_KEY="replace_with_32_byte_random_hex_key"
CLOUD_BACKUP_ENDPOINT=""
CLOUD_BACKUP_TOKEN=""

# AI Studio Runtime Environment (Managed Automatically)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
