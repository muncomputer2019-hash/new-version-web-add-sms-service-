    match /staffServicePermissions/{permissionId} {
      allow get: if isValidId(permissionId) && (isAdmin() || (isActiveTeamMember() && (existing().staffUid == request.auth.uid || existing().managerUid == request.auth.uid)));
      allow list: if isBootstrappedAdmin() || isAdmin() || (isVerifiedUser() && (existing().staffUid == request.auth.uid || existing().managerUid == request.auth.uid));
      allow create: if isValidId(permissionId) &&
        isAdmin() &&
        isValidStaffServicePermissionDoc(incoming()) &&
        incoming().permissionId == permissionId &&
        incoming().approvedByUid == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        exists(/databases/$(database)/documents/users/$(incoming().staffUid));
      allow update: if isValidId(permissionId) &&
        isAdmin() &&
        isValidStaffServicePermissionDoc(incoming()) &&
