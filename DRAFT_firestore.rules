        incoming().updatedAt == request.time;
      allow delete: if isValidId(permissionId) && isAdmin();
    }

    match /serviceApprovalLogs/{logId} {
      allow get: if isValidId(logId) && isAdmin();
      allow list: if isAdmin();
      allow create: if isValidId(logId) &&
        (isAdmin() || isManager()) &&
        isValidServiceApprovalLogDoc(incoming()) &&
        incoming().logId == logId &&
        incoming().actorUid == request.auth.uid &&
        incoming().createdAt == request.time;
    }

    // =========================================================================
    // Module 09: Employees & Payroll Engine
    // =========================================================================
    function isValidEmployeeDoc(data) {
      return data.keys().hasAll([
        'empId', 'fullName', 'designation', 'mobile', 'basicSalary',
        'status', 'createdByUid', 'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'id', 'empId', 'fullName', 'designation', 'department', 'mobile',
        'basicSalary', 'hra', 'allowances', 'pfDeduction', 'tdsDeduction',
        'netSalary', 'joiningDate', 'status', 'createdBy',
        'createdByUid', 'createdAt', 'updatedAt'
      ]) &&
      isValidId(data.empId) &&
      isBoundedString(data.fullName, 2, 120) &&
      isBoundedString(data.designation, 1, 120) &&
      isBoundedString(data.mobile, 8, 24) &&
      data.basicSalary is number && data.basicSalary >= 0 &&
      data.status in ['Active', 'Inactive', 'Terminated'] &&
      isValidId(data.createdByUid) &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidPayrollRunDoc(data) {
      return data.keys().hasAll([
        'runId', 'monthCode', 'employeeCount', 'totalGross', 'totalNet',
        'status', 'createdByUid', 'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'id', 'runId', 'monthCode', 'voucherNo', 'employeeCount',
        'totalGross', 'totalPf', 'totalTds', 'totalNet', 'slips',
        'status', 'postedBy', 'createdByUid', 'createdAt', 'updatedAt'
      ]) &&
      isValidId(data.runId) &&
      isBoundedString(data.monthCode, 4, 16) &&
      data.employeeCount is number && data.employeeCount >= 0 &&
      data.totalGross is number && data.totalGross >= 0 &&
      data.totalNet is number && data.totalNet >= 0 &&
      data.status in ['POSTED', 'DRAFT', 'REVERSED'] &&
      isValidId(data.createdByUid) &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    match /employees/{empId} {
      allow get: if isValidId(empId) && isAdminOrManager();
      allow list: if isAdminOrManager();
      allow create: if isValidId(empId) &&
        isAdminOrManager() &&
        isValidEmployeeDoc(incoming()) &&
        incoming().empId == empId &&
        incoming().createdByUid == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(empId) &&
        isAdminOrManager() &&
        isValidEmployeeDoc(incoming()) &&
        incoming().empId == existing().empId &&
        incoming().createdByUid == existing().createdByUid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time;
      allow delete: if isValidId(empId) && isAdmin();
    }

    match /payrollRuns/{runId} {
      allow get: if isValidId(runId) && isAdminOrManager();
      allow list: if isAdminOrManager();
      allow create: if isValidId(runId) &&
        isAdmin() &&
        isValidPayrollRunDoc(incoming()) &&
        incoming().runId == runId &&
        incoming().createdByUid == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(runId) &&
        isAdmin() &&
        isValidPayrollRunDoc(incoming()) &&
        incoming().runId == existing().runId &&
        incoming().createdByUid == existing().createdByUid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time;
      allow delete: if isValidId(runId) && isAdmin();
    }

    // =========================================================================
    // Phase 08: Tamper-Evident Audit Chain, Sessions, Backup/DR & Security Ops
    // =========================================================================
    function isValidTamperAuditLog(data) {
      return data.keys().hasAll([
        'auditUuid', 'userId', 'userRole', 'actionType', 'module',
        'recordId', 'actionResult', 'previousHash', 'entryHash',
        'createdByUid', 'createdAt'
      ]) &&
      data.keys().hasOnly([
        'id', 'auditUuid', 'userId', 'userRole', 'actionType', 'module',
        'recordId', 'beforeValues', 'afterValues', 'ipAddress', 'deviceInfo',
        'actionResult', 'previousHash', 'entryHash', 'createdAtIso',
        'createdByUid', 'createdAt'
      ]) &&
      isValidId(data.auditUuid) &&
      isBoundedString(data.userId, 1, 64) &&
      isBoundedString(data.userRole, 1, 40) &&
      isBoundedString(data.actionType, 2, 64) &&
      isBoundedString(data.module, 1, 64) &&
      isBoundedString(data.recordId, 1, 128) &&
      data.actionResult in ['SUCCESS', 'FAILURE', 'BLOCKED'] &&
      isBoundedString(data.previousHash, 16, 128) &&
      isBoundedString(data.entryHash, 16, 128) &&
      isValidId(data.createdByUid) &&
      data.createdAt is timestamp;
    }

    function isValidSessionDoc(data) {
      return data.keys().hasAll([
        'sessionId', 'userId', 'uid', 'status', 'expiresAt', 'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'id', 'sessionId', 'userId', 'uid', 'role', 'ipAddress',
        'deviceName', 'browserInfo', 'osInfo', 'rememberMe', 'status',
        'revokedBy', 'revokedAt', 'lastActivityAt', 'expiresAt',
        'createdAt', 'updatedAt'
      ]) &&
      isValidId(data.sessionId) &&
      isBoundedString(data.userId, 1, 64) &&
      isValidId(data.uid) &&
      data.status in ['ACTIVE', 'REVOKED', 'EXPIRED'] &&
      isBoundedString(data.expiresAt, 8, 64) &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidSystemBackupDoc(data) {
      return data.keys().hasAll([
        'backupCode', 'frequency', 'financialYear', 'versionNo', 'keyVersion',
        'checksumSha256', 'signatureHmac', 'status', 'integrityStatus',
        'createdByUid', 'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'id', 'backupCode', 'frequency', 'financialYear', 'versionNo', 'keyVersion',
        'encryptionAlgo', 'signatureAlgo', 'checksumSha256', 'signatureHmac',
        'fileSizeBytes', 'recordCounts', 'storageResults', 'status',
        'integrityStatus', 'permanentRetention', 'failureReason',
        'encryptedIv', 'encryptedBundle', 'triggeredBy', 'startedAt',
        'completedAt', 'createdByUid', 'createdAt', 'updatedAt'
      ]) &&
      isValidId(data.backupCode) &&
      isBoundedString(data.frequency, 2, 32) &&
      isBoundedString(data.financialYear, 4, 16) &&
      data.versionNo is number && data.versionNo >= 1 &&
      isBoundedString(data.keyVersion, 2, 32) &&
      isBoundedString(data.checksumSha256, 32, 128) &&
      isBoundedString(data.signatureHmac, 32, 128) &&
      data.status in ['SUCCESS', 'PARTIAL', 'FAILED', 'RESTORED'] &&
      data.integrityStatus in ['VERIFIED', 'FAILED', 'PENDING'] &&
      isValidId(data.createdByUid) &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidGenericAdminEntity(data) {
      return data.keys().hasAll(['createdByUid', 'createdAt', 'updatedAt']) &&
      isValidId(data.createdByUid) &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    match /auditLogs/{auditUuid} {
      allow get: if isValidId(auditUuid) && (isAuditorOrAdmin() || isManager() || (isVerifiedUser() && existing().createdByUid == request.auth.uid));
      allow list: if isAuditorOrAdmin() || isManager() || (isVerifiedUser() && existing().createdByUid == request.auth.uid);
      allow create: if isValidId(auditUuid) &&
        (isVerifiedUser() || isAdmin()) &&
        isValidTamperAuditLog(incoming()) &&
        incoming().auditUuid == auditUuid &&
        incoming().createdByUid == request.auth.uid &&
        incoming().createdAt == request.time;
    }

    match /sessions/{sessionId} {
      allow get: if isValidId(sessionId) && (isAdmin() || (isVerifiedUser() && existing().uid == request.auth.uid));
      allow list: if isAdmin() || (isVerifiedUser() && existing().uid == request.auth.uid);
      allow create: if isValidId(sessionId) &&
        (isVerifiedUser() || isAdmin()) &&
        isValidSessionDoc(incoming()) &&
        incoming().sessionId == sessionId &&
        incoming().uid == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(sessionId) &&
        (isAdmin() || (isVerifiedUser() && existing().uid == request.auth.uid)) &&
        isValidSessionDoc(incoming()) &&
        incoming().sessionId == existing().sessionId &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time;
      allow delete: if isValidId(sessionId) && (isAdmin() || (isVerifiedUser() && existing().uid == request.auth.uid));
    }

    match /systemBackups/{backupCode} {
      allow get: if isValidId(backupCode) && isAdminOrManager();
      allow list: if isAdminOrManager();
      allow create: if isValidId(backupCode) &&
        isAdmin() &&
        isValidSystemBackupDoc(incoming()) &&
        incoming().backupCode == backupCode &&
        incoming().createdByUid == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(backupCode) &&
        isAdmin() &&
        isValidSystemBackupDoc(incoming()) &&
        incoming().backupCode == existing().backupCode &&
        incoming().createdByUid == existing().createdByUid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time;
      allow delete: if isValidId(backupCode) && isAdmin();
    }

    match /systemRestoreHistory/{restoreCode} {
      allow get: if isValidId(restoreCode) && isAdminOrManager();
      allow list: if isAdminOrManager();
      allow create: if isValidId(restoreCode) && isAdmin() && isValidGenericAdminEntity(incoming()) && incoming().createdByUid == request.auth.uid && incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isValidId(restoreCode) && isAdmin() && isValidGenericAdminEntity(incoming()) && incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time;
    }

    match /systemSecurity/{docId} {
      allow get: if isValidId(docId) && isActiveTeamMember();
      allow list: if isAdminOrManager();
      allow create: if isValidId(docId) && isAdmin() && isValidGenericAdminEntity(incoming()) && incoming().createdByUid == request.auth.uid && incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isValidId(docId) && isAdmin() && isValidGenericAdminEntity(incoming()) && incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time;
      allow delete: if isValidId(docId) && isAdmin();
    }

    match /securityAlerts/{alertCode} {
      allow get: if isValidId(alertCode) && isAdminOrManager();
      allow list: if isAdminOrManager();
      allow create: if isValidId(alertCode) && isActiveTeamMember() && isValidGenericAdminEntity(incoming()) && incoming().createdByUid == request.auth.uid && incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isValidId(alertCode) && isAdminOrManager() && isValidGenericAdminEntity(incoming()) && incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time;
      allow delete: if isValidId(alertCode) && isAdmin();
    }

    match /securityIncidents/{incidentCode} {
      allow get: if isValidId(incidentCode) && isAdminOrManager();
      allow list: if isAdminOrManager();
      allow create: if isValidId(incidentCode) && isActiveTeamMember() && isValidGenericAdminEntity(incoming()) && incoming().createdByUid == request.auth.uid && incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isValidId(incidentCode) && isAdmin() && isValidGenericAdminEntity(incoming()) && incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time;
      allow delete: if isValidId(incidentCode) && isAdmin();
    }

    match /registeredDevices/{deviceDocId} {
      allow get: if isValidId(deviceDocId) && (isAdmin() || (isVerifiedUser() && existing().createdByUid == request.auth.uid));
      allow list: if isAdmin() || (isVerifiedUser() && existing().createdByUid == request.auth.uid);
      allow create: if isValidId(deviceDocId) && (isVerifiedUser() || isAdmin()) && isValidGenericAdminEntity(incoming()) && incoming().createdByUid == request.auth.uid && incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isValidId(deviceDocId) && (isAdmin() || (isVerifiedUser() && existing().createdByUid == request.auth.uid)) && isValidGenericAdminEntity(incoming()) && incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time;
      allow delete: if isValidId(deviceDocId) && isAdmin();
    }

    match /deletedRecords/{deletionCode} {
      allow get: if isValidId(deletionCode) && isAdminOrManager();
      allow list: if isAdminOrManager();
      allow create: if isValidId(deletionCode) && isActiveTeamMember() && isValidGenericAdminEntity(incoming()) && incoming().createdByUid == request.auth.uid && incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isValidId(deletionCode) && isAdminOrManager() && isValidGenericAdminEntity(incoming()) && incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time;
      allow delete: if isValidId(deletionCode) && isAdmin();
    }

    // =========================================================================
    // Reporting & BI Collections (Templates, Archives, Schedules, Logs)
    // =========================================================================
    function isValidReportDoc(data) {
      return data.keys().hasAll(['docId', 'createdByUid', 'createdAt', 'updatedAt']) &&
      isValidId(data.docId) &&
      isValidId(data.createdByUid) &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    match /reportTemplates/{templateCode} {
      allow get: if isValidId(templateCode) && isActiveTeamMember();
      allow list: if isActiveTeamMember();
      allow create: if isValidId(templateCode) && isActiveTeamMember() && isValidReportDoc(incoming()) && incoming().docId == templateCode && incoming().createdByUid == request.auth.uid && incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isValidId(templateCode) && (isAdminOrManager() || existing().createdByUid == request.auth.uid) && isValidReportDoc(incoming()) && incoming().docId == existing().docId && incoming().createdByUid == existing().createdByUid && incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time;
      allow delete: if isValidId(templateCode) && (isAdminOrManager() || existing().createdByUid == request.auth.uid);
    }

    match /reportArchives/{archiveCode} {
      allow get: if isValidId(archiveCode) && isActiveTeamMember();
      allow list: if isActiveTeamMember();
      allow create: if isValidId(archiveCode) && isActiveTeamMember() && isValidReportDoc(incoming()) && incoming().docId == archiveCode && incoming().createdByUid == request.auth.uid && incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isValidId(archiveCode) && isActiveTeamMember() && isValidReportDoc(incoming()) && incoming().docId == existing().docId && incoming().createdByUid == existing().createdByUid && incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time;
      allow delete: if isValidId(archiveCode) && isAdmin();
    }

    match /reportSchedules/{scheduleCode} {
      allow get: if isValidId(scheduleCode) && isAdminOrManager();
      allow list: if isAdminOrManager();
      allow create: if isValidId(scheduleCode) && isAdminOrManager() && isValidReportDoc(incoming()) && incoming().docId == scheduleCode && incoming().createdByUid == request.auth.uid && incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isValidId(scheduleCode) && isAdminOrManager() && isValidReportDoc(incoming()) && incoming().docId == existing().docId && incoming().createdByUid == existing().createdByUid && incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time;
      allow delete: if isValidId(scheduleCode) && isAdmin();
    }

    match /reportScheduleRuns/{runCode} {
      allow get: if isValidId(runCode) && isAdminOrManager();
      allow list: if isAdminOrManager();
      allow create: if isValidId(runCode) && isAdminOrManager() && isValidReportDoc(incoming()) && incoming().docId == runCode && incoming().createdByUid == request.auth.uid && incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isValidId(runCode) && isAdminOrManager() && isValidReportDoc(incoming()) && incoming().docId == existing().docId && incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time;
    }

    match /reportAuditLogs/{logId} {
      allow get: if isValidId(logId) && (isAuditorOrAdmin() || isManager() || (isVerifiedUser() && existing().createdByUid == request.auth.uid));
      allow list: if isAuditorOrAdmin() || isManager() || (isVerifiedUser() && existing().createdByUid == request.auth.uid);
      allow create: if isValidId(logId) && isActiveTeamMember() && isValidReportDoc(incoming()) && incoming().docId == logId && incoming().createdByUid == request.auth.uid && incoming().createdAt == request.time && incoming().updatedAt == request.time;
    }

    // =========================================================================
    // Phase 09: QA Command Center, Test Workbench, Bugs, DR & Release Gate
    // =========================================================================
    function isValidQaDoc(data) {
      return data.keys().hasAll(['docId', 'createdByUid', 'createdAt', 'updatedAt']) &&
      isValidId(data.docId) &&
      isValidId(data.createdByUid) &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    match /qaTestCases/{caseCode} {
      allow get: if isValidId(caseCode) && isActiveTeamMember();
      allow list: if isActiveTeamMember();
      allow create: if isValidId(caseCode) && isActiveTeamMember() && isValidQaDoc(incoming()) && incoming().docId == caseCode && incoming().createdByUid == request.auth.uid && incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isValidId(caseCode) && isActiveTeamMember() && isValidQaDoc(incoming()) && incoming().docId == existing().docId && incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time;
      allow delete: if isValidId(caseCode) && isAdmin();
    }

    match /qaExecutions/{executionCode} {
      allow get: if isValidId(executionCode) && isActiveTeamMember();
      allow list: if isActiveTeamMember();
      allow create: if isValidId(executionCode) && isActiveTeamMember() && isValidQaDoc(incoming()) && incoming().docId == executionCode && incoming().createdByUid == request.auth.uid && incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isValidId(executionCode) && isAdminOrManager() && isValidQaDoc(incoming()) && incoming().docId == existing().docId && incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time;
    }

    match /qaBugs/{bugCode} {
      allow get: if isValidId(bugCode) && isActiveTeamMember();
      allow list: if isActiveTeamMember();
      allow create: if isValidId(bugCode) && isActiveTeamMember() && isValidQaDoc(incoming()) && incoming().docId == bugCode && incoming().createdByUid == request.auth.uid && incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isValidId(bugCode) && isActiveTeamMember() && isValidQaDoc(incoming()) && incoming().docId == existing().docId && incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time;
      allow delete: if isValidId(bugCode) && isAdmin();
    }

    match /qaReconciliations/{reconciliationCode} {
      allow get: if isValidId(reconciliationCode) && isActiveTeamMember();
      allow list: if isActiveTeamMember();
      allow create: if isValidId(reconciliationCode) && isActiveTeamMember() && isValidQaDoc(incoming()) && incoming().docId == reconciliationCode && incoming().createdByUid == request.auth.uid && incoming().createdAt == request.time && incoming().updatedAt == request.time;
    }

    match /qaBackupDrills/{drillCode} {
      allow get: if isValidId(drillCode) && isActiveTeamMember();
      allow list: if isActiveTeamMember();
      allow create: if isValidId(drillCode) && isAdminOrManager() && isValidQaDoc(incoming()) && incoming().docId == drillCode && incoming().createdByUid == request.auth.uid && incoming().createdAt == request.time && incoming().updatedAt == request.time;
    }

    match /qaUatSessions/{uatCode} {
      allow get: if isValidId(uatCode) && isActiveTeamMember();
      allow list: if isActiveTeamMember();
      allow create: if isValidId(uatCode) && isActiveTeamMember() && isValidQaDoc(incoming()) && incoming().docId == uatCode && incoming().createdByUid == request.auth.uid && incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isValidId(uatCode) && isAdminOrManager() && isValidQaDoc(incoming()) && incoming().docId == existing().docId && incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time;
    }

    match /qaReleases/{releaseCode} {
      allow get: if isValidId(releaseCode) && isActiveTeamMember();
      allow list: if isActiveTeamMember();
      allow create: if isValidId(releaseCode) && isAdmin() && isValidQaDoc(incoming()) && incoming().docId == releaseCode && incoming().createdByUid == request.auth.uid && incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isValidId(releaseCode) && isAdmin() && isValidQaDoc(incoming()) && incoming().docId == existing().docId && incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time;
    }

    match /qaRegistry/{docId} {
      allow get: if isValidId(docId) && isActiveTeamMember();
      allow list: if isActiveTeamMember();
      allow create: if isValidId(docId) && isActiveTeamMember() && isValidQaDoc(incoming()) && incoming().docId == docId && incoming().createdByUid == request.auth.uid && incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isValidId(docId) && isActiveTeamMember() && isValidQaDoc(incoming()) && incoming().docId == existing().docId && incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time;
    }
  }
}
