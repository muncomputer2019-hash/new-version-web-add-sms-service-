    function isValidGrievanceDoc(data) {
      return data.keys().hasAll([
        'internalTrackingId', 'customerName', 'mobile', 'complaintCategory',
        'serviceType', 'complaintSubject', 'complaintStatus', 'paymentStatus',
        'createdByUid', 'createdAt', 'updatedAt'
      ]) &&
