      allow create: if isValidId(userId) && isAdmin() && isValidAdminMarker(incoming()) && incoming().uid == userId && incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isValidId(userId) && isAdmin() && isValidAdminMarker(incoming()) && incoming().uid == existing().uid && incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time;
      allow delete: if isValidId(userId) && isAdmin();
