    // =========================================================================
    // CSC Digital Service Center Collections (Parts 1-18)
    // =========================================================================
    function isValidCscCategoryDoc(data) {
      return data.keys().hasAll(['id', 'code', 'name', 'active', 'createdByUid', 'createdAt', 'updatedAt']) &&
      data.keys().hasOnly([
        'id', 'code', 'name', 'icon', 'description', 'displayOrder',
        'active', 'noticeText', 'moduleTag', 'createdByUid', 'createdAt', 'updatedAt'
      ]) &&
      isValidId(data.id) &&
      isBoundedString(data.code, 2, 40) &&
      isBoundedString(data.name, 2, 160) &&
      data.active is bool &&
      isValidId(data.createdByUid) &&
      (!('description' in data) || isBoundedString(data.description, 0, 500)) &&
      (!('noticeText' in data) || isBoundedString(data.noticeText, 0, 600)) &&
      (!('icon' in data) || isBoundedString(data.icon, 0, 64)) &&
      (!('moduleTag' in data) || data.moduleTag in ['GENERAL', 'PMJAY', 'MMSBY', 'NPCI', 'CYBER_CRIME', 'PVC', 'GRIEVANCE', 'RTI']) &&
      (!('displayOrder' in data) || data.displayOrder is number) &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidCscServiceOverrideDoc(data) {
      return data.keys().hasAll(['serviceId', 'rateConfigured', 'availability', 'active', 'updatedByUid', 'createdAt', 'updatedAt']) &&
      data.keys().hasOnly([
        'serviceId', 'code', 'categoryId', 'categoryName', 'subGroup', 'name', 'description',
        'serviceCharge', 'govtFee', 'totalAmount', 'unitType', 'rateConfigured', 'effectiveDate',
        'requiredDocuments', 'availability', 'active', 'moduleTag', 'updatedBy', 'updatedByUid',
        'createdAt', 'updatedAt'
      ]) &&
      isValidId(data.serviceId) &&
      data.rateConfigured is bool &&
      data.availability in ['Available', 'Unavailable'] &&
      data.active is bool &&
      isValidId(data.updatedByUid) &&
      (!('name' in data) || isBoundedString(data.name, 2, 200)) &&
      (!('serviceCharge' in data) || data.serviceCharge == null || (data.serviceCharge is number && data.serviceCharge >= 0)) &&
      (!('govtFee' in data) || data.govtFee == null || (data.govtFee is number && data.govtFee >= 0)) &&
      (!('totalAmount' in data) || data.totalAmount == null || (data.totalAmount is number && data.totalAmount >= 0)) &&
      (!('unitType' in data) || data.unitType == null || isBoundedString(data.unitType, 2, 40)) &&
      (!('requiredDocuments' in data) || (data.requiredDocuments is list && data.requiredDocuments.size() <= 30 && (data.requiredDocuments.size() == 0 || data.requiredDocuments[0] is string))) &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidCscRateHistoryDoc(data) {
      return data.keys().hasAll(['id', 'serviceId', 'newServiceCharge', 'newGovtFee', 'newTotalAmount', 'newUnitType', 'createdByUid', 'createdAt']) &&
      data.keys().hasOnly([
        'id', 'serviceId', 'serviceCode', 'serviceName', 'categoryName', 'adminId',
        'oldServiceCharge', 'newServiceCharge', 'oldGovtFee', 'newGovtFee',
        'oldTotalAmount', 'newTotalAmount', 'oldUnitType', 'newUnitType',
        'effectiveDate', 'changeReason', 'changedAt', 'createdByUid', 'createdAt'
      ]) &&
      isValidId(data.id) &&
      isValidId(data.serviceId) &&
      data.newServiceCharge is number && data.newServiceCharge >= 0 &&
      data.newGovtFee is number && data.newGovtFee >= 0 &&
      data.newTotalAmount is number && data.newTotalAmount >= 0 &&
      isBoundedString(data.newUnitType, 2, 40) &&
      isValidId(data.createdByUid) &&
      data.createdAt is timestamp;
    }

    function isValidPvcSlabDoc(data) {
      return data.keys().hasAll(['id', 'mode', 'minQty', 'maxQty', 'ratePerCard', 'active', 'createdByUid', 'createdAt', 'updatedAt']) &&
      data.keys().hasOnly(['id', 'mode', 'minQty', 'maxQty', 'ratePerCard', 'active', 'updatedBy', 'createdByUid', 'createdAt', 'updatedAt']) &&
      isValidId(data.id) &&
      data.mode in ['INDIVIDUAL', 'WHOLESALE'] &&
      data.minQty is number && data.minQty >= 1 &&
      data.maxQty is number && data.maxQty >= data.minQty &&
      data.ratePerCard is number && data.ratePerCard >= 0 &&
      data.active is bool &&
      isValidId(data.createdByUid) &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidWholesaleShopDoc(data) {
      return data.keys().hasAll(['id', 'shopCode', 'shopName', 'ownerName', 'mobile', 'active', 'createdByUid', 'createdAt', 'updatedAt']) &&
      data.keys().hasOnly(['id', 'shopCode', 'shopName', 'ownerName', 'mobile', 'altMobile', 'address', 'registrationDate', 'remarks', 'active', 'createdByUid', 'createdAt', 'updatedAt']) &&
      isValidId(data.id) &&
      isBoundedString(data.shopName, 2, 160) &&
      isBoundedString(data.ownerName, 2, 120) &&
      isBoundedString(data.mobile, 8, 24) &&
      data.active is bool &&
      isValidId(data.createdByUid) &&
